TZ=America/Sao_Paulo
VAULT_PATH=./vault
REPOS_CONFIG_PATH=./system/bridge/repos.json

# Roteador Nível 2 (Nuvem)
N2_PROVIDER=gemini
N2_MODEL=gemini-2.5-flash
GEMINI_API_KEY=cole_sua_chave_aqui
ANTHROPIC_API_KEY=opcional_se_usar_haiku

# Controle de Custo Diário
DAILY_BUDGET_USD=2.00
DAILY_N2_LIMIT_CALLS=100
DAILY_N3_LIMIT_CALLS=25
COST_ALERT_THRESHOLD=0.80

# Notificações Telegram
TELEGRAM_BOT_TOKEN=cole_seu_token_aqui
TELEGRAM_CHAT_ID=cole_seu_chat_id_aqui
