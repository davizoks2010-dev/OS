# =============================================================
# Agent OS — modelo de variáveis de ambiente
# Copie para .env (que fica fora do Git) e preencha os valores.
# NUNCA escreva estes valores em vault/, logs/ ou outputs/.
# =============================================================

# --- Geral ---
AGENTOS_TZ=America/Sao_Paulo
AGENTOS_ROOT=C:\Users\Davi\AgentOS
AGENTOS_VAULT=C:\Users\Davi\AgentOS\vault

# --- Telegram (Bloco 3) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Roteador (Bloco 4) ---
# Nível 3: Claude Code headless (usa a assinatura logada no `claude`)
CLAUDE_CLI=claude
ROUTER_MIN_CONFIDENCE=0.70
# Nível 2: provedor e modelo — definido no Checkpoint 1
L2_PROVIDER=
L2_MODEL=
L2_API_KEY=

# --- Painel (Bloco 5) ---
PANEL_HOST=127.0.0.1
PANEL_PORT=8000

# --- Repositórios locais monitorados (Bloco 2) ---
# Formato: nome=caminho;nome=caminho
PROJECT_REPOS=app-proprio=C:\dev\app-proprio;mesa-solana=C:\dev\mesa-solana
